# Anthropic API key. Required.
# On dellan: agenix decrypts to a path; the wrapper sets
# ANTHROPIC_API_KEY_FILE = config.age.secrets.anthropic-api-key.path
# and the Python CLI reads from FILE if set, else from KEY.
ANTHROPIC_API_KEY=

# Alternative: point at a file containing the raw key (mode 0400).
# Wrapper on dellan sets this to the agenix decrypt path.
# ANTHROPIC_API_KEY_FILE=

# Optional. Defaults to claude-sonnet-4-6.
# PROSE_DECORATE_MODEL=claude-sonnet-4-6

# Optional. Override cache dir (default: platformdirs user cache / "prose-decorate").
# PROSE_DECORATE_CACHE_DIR=
